{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fotocull",
  "version": "1.0.0",
  "identifier": "com.octoone.fotocull",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "fotocull",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Fast photo culling (JPG+ARW) from an SD card",
    "longDescription": "fotocull is a fast, keyboard-driven culling tool for camera photos. Scan an SD card, review JPGs Tinder-style, keep or reject, optionally rename, and copy accepted shots (with their ARW companions) to a destination folder. Already-copied photos are skipped by content hash, so re-runs only show what's new.",
    "copyright": "Copyright \u00a9 2026 octoone",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
